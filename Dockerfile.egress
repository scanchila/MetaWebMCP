FROM node:22.23.2-alpine3.24@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32
WORKDIR /app
COPY --chown=node:node egress-proxy.mjs ./
COPY --chown=node:node public/js/network-policy.js ./public/js/network-policy.js
ENV NODE_ENV=production EGRESS_PROXY_HOST=0.0.0.0 EGRESS_PROXY_PORT=8080
EXPOSE 8080
USER node
CMD ["node", "egress-proxy.mjs"]
