{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "captured_at", "source_url", "pages_scanned", "results", "limitations"],
  "properties": {
    "status": { "type": "string", "enum": ["completed", "partial", "failed"] },
    "captured_at": { "type": "string" },
    "source_url": { "type": "string", "minLength": 1 },
    "pages_scanned": { "type": "integer", "minimum": 0, "maximum": 20 },
    "results": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["app_id", "app_url", "discount_pct", "original_price_usd", "sale_price_usd"],
        "properties": {
          "app_id": { "type": "integer", "minimum": 1 },
          "app_url": { "type": "string", "minLength": 1 },
          "discount_pct": { "type": "number", "minimum": 50, "maximum": 80 },
          "original_price_usd": { "type": "number", "minimum": 0.99 },
          "sale_price_usd": { "type": "number", "minimum": 0, "maximum": 0.49 }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
