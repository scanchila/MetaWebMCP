{
  "name": "metawebmcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Build, test, and export WebMCP tools from live website workflows.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "NODE_ENV=development node --watch server.mjs",
    "check": "node scripts/check.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:evidence": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:e2e": "python3 tests/e2e.py",
    "test": "npm run check && npm run test:unit && npm run test:evidence && npm run test:e2e"
  },
  "license": "MIT"
}
