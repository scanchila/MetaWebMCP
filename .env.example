PORT=8787
HOST=0.0.0.0
# Optional. Point this at a standard Streamable HTTP browser MCP server.
# The official Playwright MCP Docker service listens at /mcp. Do not enable it
# until that browser runtime has connection-level private-network egress controls.
BROWSER_MCP_URL=
# This declaration enables the bridge; it does not implement the required boundary.
BROWSER_MCP_EGRESS_ISOLATED=0
# Expire each page-scoped Browser MCP client after inactivity (milliseconds).
MCP_SESSION_TTL_MS=1200000
# Set only for local development if you intentionally need localhost/private targets.
ALLOW_PRIVATE_TARGETS=0
# Comma-separated origins the external browser may initially navigate to.
# Example: https://example.com,https://shop.example.com
BROWSER_ALLOWED_ORIGINS=
