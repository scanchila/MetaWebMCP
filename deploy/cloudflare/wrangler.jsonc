{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "metawebmcp",
  "main": "worker.mjs",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "metawebmcp.neuryta.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "@cloudflare/playwright/fs": "./fs-shim.mjs"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "ratelimits": [
    {
      "name": "BROWSER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "PlaywrightMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PlaywrightMCP"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
