{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "metawebmcp",
  "main": "worker.mjs",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "metawebmcp.neuryta.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "alias": {
    "@cloudflare/playwright/fs": "./fs-shim.mjs"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "HOSTED_BROWSER_ENABLED": "1",
    "HOSTED_BROWSER_ENGINE": "chromium"
  },
  "ratelimits": [
    {
      "name": "BROWSER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "EXPORT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "ANALYSIS_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "SHARED_WORKSPACE_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "SHARED_WORKSPACE_ACCESS_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 240,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "PlaywrightMCP"
      },
      {
        "name": "EXPORT_STORE",
        "class_name": "ExportStore"
      },
      {
        "name": "SHARED_WORKSPACE_STORE",
        "class_name": "SharedWorkspaceStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PlaywrightMCP"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ExportStore"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SharedWorkspaceStore"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
